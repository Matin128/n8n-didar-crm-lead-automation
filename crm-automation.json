    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // ۱. استخراج متن خام از خروجی هوش مصنوعی\n  // (اگر نام کلید خروجی نود AI شما متفاوت است، آن را جایگزین کنید)\n  let rawText = item.json.text || item.json.output || item.json.content || item.json.response || \"\";\n\n  // ۲. پاک‌سازی کاراکترهای اضافی، تگ‌های Markdown و فواصل\n  rawText = rawText\n    .replace(/```json/gi, \"\")\n    .replace(/```/g, \"\")\n    .trim();\n\n  let parsedData = {};\n\n  try {\n    // ۳. تبدیل متن پاک‌سازی شده به یک آبجکت واقعی JSON\n    parsedData = JSON.parse(rawText);\n  } catch (error) {\n    // ۴. مقدار جایگزین (Fallback) در صورت بروز خطا در پارس کردن AI\n    parsedData = {\n      lead_status: \"WARM\",\n      lead_score_fa: \"🟡 متوسط (WARM)\",\n      summary: \"پاسخ هوش مصنوعی ساختار استاندارد نداشت: \" + rawText,\n      recommended_action: \"بررسی دستی درخواست توسط کارشناس فروش.\"\n    };\n  }\n\n  // ۵. تزریق مقادیر تمیزشده به خروجی نهای برای استفاده در نودهای بعدی\n  item.json.lead_status = parsedData.lead_status || \"WARM\";\n  item.json.lead_score_fa = parsedData.lead_score_fa || \"🟡 متوسط (WARM)\";\n  item.json.summary = parsedData.summary || \"بدون خلاصه\";\n  item.json.recommended_action = parsedData.recommended_action || \"پیگیری اولیه با مشتری\";\n}\n\nreturn $input.all();"
      },
